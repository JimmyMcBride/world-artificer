# ──────────────────────────────────────────────────────────────────────────────
# Frontend (Next.js – copy to .env.local)
# ──────────────────────────────────────────────────────────────────────────────
# Auth0 (public)
NEXT_PUBLIC_AUTH0_DOMAIN=               # e.g. your-domain.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=            # e.g. abc123XYZ

# API
NEXT_PUBLIC_API_URL=                    # e.g. http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Backend (copy to .env)
# ──────────────────────────────────────────────────────────────────────────────
# Database
DATABASE_URL=                           # e.g. postgresql://user:pass@localhost:5432/worldbuilding

# Cache
REDIS_URL=                              # e.g. redis://localhost:6379

# AI Services
OPENAI_API_KEY=                         # e.g. sk-...
PINECONE_API_KEY=                       # e.g. pc-...
PINECONE_INDEX_NAME=                   # e.g. worldbuilding-vectors
PINECONE_ENVIRONMENT=                   # e.g. us-east-1

# ──────────────────────────────────────────────────────────────────────────────
# Shared / Auth0 (server-side)
# ──────────────────────────────────────────────────────────────────────────────
AUTH0_SECRET=                           # long, random string
AUTH0_ISSUER_BASE_URL=                  # e.g. https://your-domain.auth0.com
AUTH0_BASE_URL=                         # e.g. http://localhost:3000
AUTH0_CLIENT_ID=                        # same as NEXT_PUBLIC_AUTH0_CLIENT_ID
AUTH0_CLIENT_SECRET=                    # Auth0 client secret

# ──────────────────────────────────────────────────────────────────────────────
# Monitoring & Deployment
# ──────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=                             # e.g. https://<key>@o0.ingest.sentry.io/0
VERCEL_PROJECT_ID=                      # from your Vercel dashboard
